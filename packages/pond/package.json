{
    "name": "@fkleon/pondjs",
    "version": "1.0.0-alpha.11",
    "description": "A TimeSeries library built on Immutable.js with Typescript",
    "keywords": [
        "timeseries"
    ],
    "homepage": "https://github.com/fkleon/pond#readme",
    "bugs": {
        "url": "https://github.com/fkleon/pond/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fkleon/pond.git",
        "directory": "packages/pond"
    },
    "license": "BSD-3-Clause-LBNL",
    "author": "Software Engineering Group at ESnet",
    "type": "commonjs",
    "main": "lib/exports.js",
    "types": "lib/exports.d.ts",
    "directories": {
        "lib": "lib",
        "test": "tests"
    },
    "files": [
        "/lib"
    ],
    "scripts": {
        "build": "tsc --version && tsc",
        "watch": "tsc --watch",
        "docs": "typedoc --json ../website/src/doc.json --mode modules ./src/*.ts",
        "test": "jest",
        "lint": "tslint ./src/*.ts",
        "format": "prettier ./src/*.ts --write"
    },
    "dependencies": {
        "immutable": "^4.3.7",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.45"
    },
    "devDependencies": {
        "@types/lodash": "^4.14.202",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "tslint": "^6.1.3",
        "tslint-config-prettier": "^1.18.0",
        "typedoc": "^0.18.0",
        "typescript": "^5.6.2"
    },
    "engines": {
        "node": ">=14"
    },
    "jest": {
        "transform": {
            ".(ts|tsx)": "ts-jest"
        },
        "testRegex": "(/tests/.*)\\.(ts|tsx|js)$",
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js"
        ]
    }
}
